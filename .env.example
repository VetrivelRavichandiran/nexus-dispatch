# NEXUS-DISPATCH environment configuration.
#
# Copy to `.env` and adjust. Every service reads these from its environment;
# docker-compose.yml sets them for the full stack. For local (non-docker)
# development, `export $(grep -v '^#' .env | xargs)` in your shell.

# --- Kafka ---
KAFKA_BROKERS=localhost:9092

# --- Redis (hot state + H3 index + reservation leases) ---
REDIS_ADDR=localhost:6379
REDIS_DB=0

# --- PostgreSQL / PostGIS (durable state) ---
POSTGRES_DSN=postgres://nexus:nexus@localhost:5432/nexus?sslmode=disable

# --- Auth ---
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRY=24h

# --- Dispatch tuning ---
DEFAULT_RADIUS_M=1000
LEASE_TTL=30s
LEASE_RENEW=10s
STALE_DRIVER_AFTER=90s

# --- Rate limiting (token bucket, per IP / per user) ---
USER_RATE_CAPACITY=60
USER_RATE_REFILL=1
IP_RATE_CAPACITY=300
IP_RATE_REFILL=5

# --- Tracing (optional; leave empty to disable OTLP export) ---
OTLP_ENDPOINT=

# --- gRPC backend addresses (gateway + dispatch-engine) ---
# Defaults to localhost:<well-known-port>; override when services run in
# separate containers/hosts (docker-compose sets these to service names).
#BACKEND_HOST=localhost
#DRIVER_SERVICE_GRPC_ADDR=localhost:9001
#RIDE_SERVICE_GRPC_ADDR=localhost:9002
#LOCATION_SERVICE_GRPC_ADDR=localhost:9003
#DISPATCH_ENGINE_GRPC_ADDR=localhost:9004